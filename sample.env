# sample.env - Environment template for Pomo
# Copy to .env: cp sample.env .env

# Flutter and Java Toolchain (CI and build scripts)
FLUTTER_VERSION=3.27.0
JAVA_VERSION=17

# Android Release Signing (Optional: needed for signed release APKs)
# See specs/android.md and AGENTS.md for keystore instructions
# ANDROID_KEYSTORE_PATH=/path/to/pomo-release.jks
# ANDROID_KEYSTORE_ALIAS=pomo
# ANDROID_KEYSTORE_PASSWORD=your_keystore_password
# ANDROID_KEYSTORE_PRIVATE_KEY_PASSWORD=your_key_password

# Vercel Serverless Notion Proxy (Optional: for Web PWA)
# NOTION_TOKEN=secret_...
# FOCUS_ACCESS_TOKEN=your_shared_access_token

# Cloudflare Edge Sync Worker (Optional: for worker/ deployment)
# FOCUS_ACCESS_TOKEN=your_shared_access_token

# Custom Sync Relay Endpoint (Optional: defaults to Cloudflare Edge Worker)
# POMO_SYNC_RELAY_URL=https://sync.rawshn.com
